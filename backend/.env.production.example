# Production Environment Variables for Voting System
# Copy this file to .env and fill in your actual values

# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-here-must-be-long-and-random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=voting-system-tbti.vercel.app,*.vercel.app
VERCEL=true

# Database Configuration (Supabase)
# Option 1: Use DATABASE_URL (preferred)
DATABASE_URL=postgresql://username:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Option 2: Use individual database variables
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your-supabase-password
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432

# Redis Configuration (optional, for caching)
REDIS_URL=redis://username:password@your-redis-host:6379/0

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=candidate-images

# Security Configuration
ADMIN_API_KEY=your-admin-api-key-here
ADMIN_INVITE_KEY=your-admin-invite-key-here

# Email Configuration (for MFA)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# AWS Configuration (for backups)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-backup-bucket-name
AWS_S3_REGION=us-east-1

# Application Configuration
CANDIDATE_RETENTION_DAYS=2
MFA_CODE_INTERVAL_SECONDS=3600
MFA_PREAUTH_MAX_AGE_SECONDS=345600
ADMIN_MFA_REVERIFY_HOURS=0

# Frontend Configuration
FRONTEND_URL=https://voting-system-tbti.vercel.app
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_FILE=/tmp/django.log
SECURITY_LOG_FILE=/tmp/security.log

# Performance Configuration
CONN_MAX_AGE=600
MAX_CONNS=20
MIN_CONNS=5
